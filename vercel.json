{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "dist/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ops-monitor",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=:path*"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api?__route=share/collection/:slug"
    },
    {
      "source": "/nft/:id",
      "destination": "/api?__route=share/nft/:id"
    },
    {
      "source": "/post/:id",
      "destination": "/api?__route=share/post/:id"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
