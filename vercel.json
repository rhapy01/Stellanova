{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "dist/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ops-monitor",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/marketplace-maintenance",
      "schedule": "15 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api?__route=robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__route=sitemap.xml"
    },
    {
      "source": "/explore",
      "destination": "/api?__route=share/page/explore"
    },
    {
      "source": "/collections",
      "destination": "/api?__route=share/page/collections"
    },
    {
      "source": "/creator/:id",
      "destination": "/api?__route=share/creator/:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__route=:path*"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api?__route=share/collection/:slug"
    },
    {
      "source": "/nft/:id",
      "destination": "/api?__route=share/nft/:id"
    },
    {
      "source": "/post/:id",
      "destination": "/api?__route=share/post/:id"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
